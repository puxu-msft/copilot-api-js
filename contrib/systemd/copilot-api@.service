# contrib/systemd/copilot-api@.service
# blue-green 双槽模板：实例化为 copilot-api@a / copilot-api@b。
# 零停机换代靠 app 层 reusePort 接管（见 copilot-api-deploy.sh），非 socket activation。
# 详见 docs/lifecycle.md「路径二：systemd blue-green 模板单元 + reusePort」。
[Unit]
Description=copilot-api (slot %i)
After=network.target

[Service]
Type=notify
# 用 bun 直连入口（非 `bun run`，否则 LISTEN_PID/notify 归属子进程混乱，见 README）
# 路径按实际部署位置改写（此处为样例默认值）。
ExecStart=/usr/bin/bun /opt/copilot-api/src/main.ts start
# 交接时旧槽 drain 完 exit 0 → 不复活；仅真崩溃（非零退出）重启同色槽。
# 定成 always 会把每次交接（正常 exit 0）当故障无限拉起，见 README。
Restart=on-failure
# systemd 必须配置有限 hard timeout；它不是应用级请求 deadline。样例按
# timeouts.request_deadline=1200s 加 100s durability 余量。设 request_deadline=0
# 时任何有限值都无法保证无损排空，应由部署脚本确认旧槽请求清零后再 stop。
TimeoutStopSec=1300
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
