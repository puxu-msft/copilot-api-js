{
  "name": "@hsupu/copilot-api",
  "version": "0.8.4-beta.8",
  "description": "Turn GitHub Copilot into an OpenAI/Anthropic API compatible provider. Use Gemini and Claude models with Codex CLI through your Copilot subscription.",
  "keywords": [
    "github-copilot",
    "claude",
    "codex-cli",
    "proxy",
    "openai-compatible",
    "anthropic-compatible",
    "gemini",
    "codex-plugin"
  ],
  "homepage": "https://github.com/puxu-msft/copilot-api-js",
  "bugs": "https://github.com/puxu-msft/copilot-api-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puxu-msft/copilot-api-js.git"
  },
  "author": "hsupu",
  "type": "module",
  "bin": {
    "copilot-api": "dist/main.mjs"
  },
  "files": [
    "dist",
    "ui/dist",
    "config.yaml",
    "config.example.yaml"
  ],
  "scripts": {
    "build": "npm run build:ui && npm run build:backend",
    "build:backend": "npx tsdown",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev": "bun run --watch ./src/main.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "generate:config-schema": "bun run scripts/generate-config-json-schema.ts",
    "knip": "knip-bun",
    "lint": "eslint --cache",
    "lint:all": "eslint --cache .",
    "prepack": "npm run build",
    "prepare": "npm run build && (command -v bun >/dev/null 2>&1 && simple-git-hooks || true)",
    "preview:ui": "vite preview --config ui/vite.config.ts",
    "release": "bumpp && npm publish --access public",
    "start": "NODE_ENV=production bun run ./src/main.ts",
    "test": "npm run test:backend",
    "test:acceptance": "npm run test:backend && npm run test:ui && npm run test:e2e-ui",
    "test:all": "npm run test:backend && npm run test:ui",
    "test:backend": "bun test .unit.test .it.test .http.test",
    "test:ci": "npm run test:backend",
    "test:cov": "bun test --coverage .unit.test .it.test .http.test",
    "test:cov:report": "bun test --coverage --coverage-reporter lcov .unit.test .it.test .http.test",
    "test:unit": "bun test .unit.test",
    "test:it": "bun test .it.test",
    "test:http": "bun test .http.test",
    "test:e2e": "bun test tests/e2e/",
    "test:e2e-ui": "bunx playwright test",
    "test:e2e-ui:local": "PLAYWRIGHT_BASE_URL=http://localhost:4141 bunx playwright test",
    "test:ui": "npm run test:ui:bun && npm run test:ui:vitest",
    "test:ui:bun": "bun test ./ui/tests/",
    "test:ui:vitest": "vitest run --config ui/vitest.config.ts",
    "typecheck": "tsc && tsc --noEmit --project tests/e2e-ui/tsconfig.json",
    "typecheck:ui": "vue-tsc --noEmit --project ui/tsconfig.json"
  },
  "simple-git-hooks": {
    "pre-commit": "bun x lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,vue}": "bun run lint"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@hono/node-ws": "^1.3.1",
    "@mdi/font": "^7.4.47",
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "diff": "^9.0.0",
    "fetch-event-stream": "^0.1.6",
    "gpt-tokenizer": "^3.4.0",
    "hono": "^4.12.23",
    "picocolors": "^1.1.1",
    "pinia": "^3.0.4",
    "proxy-from-env": "^2.1.0",
    "socks": "^2.8.9",
    "tiny-invariant": "^1.3.3",
    "undici": "7.28.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vue": "^3.5.35",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "^5.1.0",
    "vuetify": "^4.0.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.100.0",
    "@echristian/eslint-config": "^0.0.54",
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.3.14",
    "@types/diff": "^8.0.0",
    "@types/proxy-from-env": "^1.0.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.10",
    "bumpp": "^11.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.1",
    "jsdom": "^29.1.1",
    "knip": "^6.15.0",
    "lint-staged": "^16.4.0",
    "openai": "^6.39.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.3"
  }
}
