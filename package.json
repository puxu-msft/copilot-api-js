{
  "name": "@hsupu/copilot-api",
  "version": "0.8.4-beta.16",
  "description": "Turn GitHub Copilot into an OpenAI/Anthropic API compatible provider. Use Gemini and Claude models with Codex CLI through your Copilot subscription.",
  "keywords": [
    "anthropic-compatible",
    "claude-code",
    "claude",
    "codex",
    "gemini",
    "github-copilot",
    "openai-compatible",
    "proxy"
  ],
  "homepage": "https://github.com/puxu-msft/copilot-api-js",
  "bugs": "https://github.com/puxu-msft/copilot-api-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puxu-msft/copilot-api-js.git"
  },
  "author": "hsupu",
  "type": "module",
  "bin": {
    "copilot-api": "dist/main.mjs"
  },
  "files": [
    "dist",
    "ui/dist",
    "ui-v4/dist",
    "config.yaml",
    "config.example.yaml"
  ],
  "workspaces": [
    "ui",
    "ui-v4",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:ui && bun run build:ui-v4 && bun run build:backend && bun run build:history-search",
    "build:backend": "bun x tsdown",
    "build:history-search": "bun run scripts/build-history-search.ts",
    "build:ui": "bun run --filter copilot-api-ui build",
    "build:ui-v4": "bun run --filter copilot-api-ui-v4 build",
    "dev": "bun run --watch ./src/main.ts",
    "dev:ui": "bun run --filter copilot-api-ui dev",
    "dev:ui-v4": "bun run --filter copilot-api-ui-v4 dev",
    "generate:config-schema": "bun run scripts/generate-config-json-schema.ts",
    "knip": "knip-bun",
    "lint": "eslint --cache",
    "lint:all": "eslint .",
    "prepack": "bun run build",
    "prepare": "bun run build",
    "preview:ui": "bun run --filter copilot-api-ui preview",
    "release": "bumpp && bun publish --access public",
    "start": "NODE_ENV=production bun run ./src/main.ts",
    "test": "bun run test:fast",
    "test:fast": "bun run build:history-search && bun scripts/parallel-test.ts unit http",
    "test:fast:isolated": "bun run build:history-search && bun test --parallel .unit.test .http.test",
    "test:acceptance": "bun run test:backend && bun run test:ui && bun run test:ui-v4 && bun run test:e2e-ui",
    "test:all": "bun run test:backend && bun run test:ui && bun run test:ui-v4",
    "test:backend": "bun run build:history-search && bun scripts/parallel-test.ts unit it http",
    "test:backend:isolated": "bun run build:history-search && bun test --parallel .unit.test .it.test .http.test",
    "test:timings": "bun run build:history-search && bun scripts/parallel-test.ts --update unit it http",
    "test:ci": "bun run test:backend && bun run test:pty && bun run test:e2e",
    "test:pty": "bun test .pty.test",
    "test:cov": "bun run build:history-search && bun test --parallel --coverage .unit.test .it.test .http.test",
    "test:cov:report": "bun run build:history-search && bun test --parallel --coverage --coverage-reporter lcov .unit.test .it.test .http.test",
    "test:unit": "bun test --parallel .unit.test",
    "test:it": "bun test --parallel .it.test",
    "test:http": "bun test --parallel .http.test",
    "test:e2e": "bun test .e2e.test",
    "test:e2e-ui": "bunx playwright test",
    "test:e2e-ui:local": "PLAYWRIGHT_BASE_URL=http://localhost:4141 bunx playwright test",
    "test:ui": "bun run --filter copilot-api-ui test",
    "test:ui-v4": "bun run --filter copilot-api-ui-v4 test",
    "test:ui:bun": "bun run --filter copilot-api-ui test:bun",
    "test:ui:vitest": "bun run --filter copilot-api-ui test:vitest",
    "typecheck": "tsc && tsc --noEmit --project tests/e2e-ui/tsconfig.json",
    "typecheck:ui": "bun run --filter copilot-api-ui typecheck",
    "typecheck:ui-v4": "bun run --filter copilot-api-ui-v4 typecheck"
  },
  "dependencies": {
    "@datadog/sketches-js": "2.1.1",
    "@google/genai": "^2.10.0",
    "@hono/node-server": "^2.0.6",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-openapi": "^1.4.0",
    "@scalar/hono-api-reference": "^0.11.6",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "diff": "^9.0.0",
    "fetch-event-stream": "^0.1.6",
    "gpt-tokenizer": "^3.4.0",
    "hono": "^4.12.27",
    "jsonrepair": "^3.14.1",
    "picocolors": "^1.1.1",
    "pino": "10.3.1",
    "pino-roll": "4.0.0",
    "proxy-from-env": "^2.1.0",
    "safe-stable-stringify": "2.5.0",
    "serialize-error": "13.0.1",
    "slice-ansi": "^9.0.0",
    "socks": "^2.8.9",
    "string-width": "^7.2.0",
    "tiny-invariant": "^1.3.3",
    "umzug": "^3.8.3",
    "undici": "7.28.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.13",
    "@anthropic-ai/sdk": "0.106.0",
    "@echristian/eslint-config": "^0.0.54",
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.3.14",
    "@types/diff": "^8.0.0",
    "@types/proxy-from-env": "^1.0.4",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@xterm/headless": "6.0.0",
    "bumpp": "^11.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.2",
    "knip": "^6.23.0",
    "openai": "^6.45.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "tsdown": "^0.22.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
